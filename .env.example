# ============================================
# 数据库配置
# ============================================
POSTGRES_DB=quantflow
POSTGRES_USER=quantflow_user
POSTGRES_PASSWORD=change_this_to_strong_password_min_16_chars
DATABASE_URL=postgresql://quantflow_user:change_this_to_strong_password_min_16_chars@postgres:5432/quantflow

# ============================================
# Redis 缓存配置
# ============================================
REDIS_PASSWORD=change_this_to_strong_redis_password
REDIS_URL=redis://:change_this_to_strong_redis_password@redis:6379/0

# ============================================
# 安全配置
# ============================================
# 生成方法: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change_this_to_random_secret_key_min_32_chars
JWT_SECRET_KEY=change_this_to_random_jwt_secret_key_min_32_chars
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# 加密密钥（必须是 32 字节）
# 生成方法: python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=change_this_to_32_byte_encryption_key

# ============================================
# CORS 配置
# ============================================
# 多个域名用逗号分隔
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# ============================================
# AI 模型配置
# ============================================
# 留空则需要用户在应用设置页面配置自己的 API Key
# 支持的服务商：
# - 阶跃星辰 (StepFun): https://platform.stepfun.com
# - Kimi (月之暗面): https://platform.moonshot.cn
# - OpenAI: https://platform.openai.com
STEPFUN_API_KEY=
KIMI_API_KEY=
OPENAI_API_KEY=

# ============================================
# 外部 API 配置（可选）
# ============================================
# Alpha Vantage API（历史数据）
# 免费注册：https://www.alphavantage.co/support/#api-key
# 免费版限制：5次/分钟，500次/天
ALPHA_VANTAGE_API_KEY=

# Twelve Data API（备用数据源）
# 免费注册：https://twelvedata.com
TWELVE_DATA_API_KEY=

# 新闻API（可选）
# 免费注册：https://newsapi.org
NEWS_API_KEY=

# ============================================
# 应用配置
# ============================================
ENVIRONMENT=production
LOG_LEVEL=INFO
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ============================================
# 更新频率（分钟）
# ============================================
MARKET_INSIGHT_INTERVAL=15
RISK_ANALYSIS_INTERVAL=60
SENTIMENT_MAP_INTERVAL=60
