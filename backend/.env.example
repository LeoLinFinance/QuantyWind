# 数据库配置
MONGODB_URI=mongodb://localhost:27017/didaxueshu

# 服务端口
PORT=3000

# AI API配置
KIMI_API_KEY=your_kimi_api_key
CLAUDE_API_KEY=your_claude_api_key
