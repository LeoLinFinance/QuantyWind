.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
}

.audio-player {
  background: #fff;
  padding: 30rpx;
  border-bottom: 1px solid #eee;
}

.player-controls {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.play-btn {
  width: 60rpx;
  height: 60rpx;
}

.progress-bar {
  flex: 1;
}

.time-info {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #999;
  margin-top: 10rpx;
}

.article-header {
  background: #fff;
  padding: 30rpx;
  border-bottom: 1px solid #eee;
}

.article-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.5;
  display: block;
  margin-bottom: 20rpx;
}

.article-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  font-size: 24rpx;
  color: #999;
}

.category {
  background: #e8f4ff;
  color: #1890ff;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.layer-tabs {
  display: flex;
  background: #fff;
  padding: 20rpx 30rpx;
  border-bottom: 1px solid #eee;
}

.layer-tab {
  flex: 1;
  text-align: center;
  padding: 15rpx 0;
  font-size: 28rpx;
  color: #666;
  border-bottom: 3rpx solid transparent;
}

.layer-tab.active {
  color: #1a1a2e;
  font-weight: bold;
  border-bottom-color: #1a1a2e;
}

.content-area {
  flex: 1;
  padding: 30rpx;
}

.content-text {
  background: #fff;
  padding: 30rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  line-height: 1.8;
  color: #333;
  margin-bottom: 30rpx;
}

.ai-chat-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-top: 30rpx;
}

.chat-header {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.chat-messages {
  max-height: 600rpx;
  overflow-y: auto;
  margin-bottom: 20rpx;
}

.message {
  padding: 20rpx;
  margin-bottom: 15rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.message.user {
  background: #1a1a2e;
  color: #fff;
  margin-left: 60rpx;
}

.message.assistant {
  background: #f0f0f0;
  color: #333;
  margin-right: 60rpx;
}

.chat-input-box {
  display: flex;
  gap: 15rpx;
  align-items: center;
}

.chat-input {
  flex: 1;
  background: #f5f5f5;
  padding: 20rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
}

.send-btn {
  background: #1a1a2e;
  color: #fff;
  padding: 20rpx 40rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
}

.action-bar {
  display: flex;
  background: #fff;
  border-top: 1px solid #eee;
  padding: 20rpx 30rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  color: #666;
}

.action-btn image {
  width: 48rpx;
  height: 48rpx;
}
