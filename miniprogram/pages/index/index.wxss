.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
}

.category-nav {
  background: #fff;
  padding: 20rpx 0;
  border-bottom: 1px solid #eee;
}

.category-list {
  display: flex;
  padding: 0 30rpx;
  white-space: nowrap;
}

.category-item {
  padding: 10rpx 30rpx;
  margin-right: 20rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
  color: #666;
  background: #f5f5f5;
}

.category-item.active {
  background: #1a1a2e;
  color: #fff;
}

.content-list {
  flex: 1;
  padding: 20rpx;
}

.article-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

.article-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.5;
  display: block;
  margin-bottom: 15rpx;
}

.article-meta {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.category-tag {
  background: #e8f4ff;
  color: #1890ff;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  margin-right: 15rpx;
}

.time {
  font-size: 24rpx;
  color: #999;
}

.article-summary {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.article-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.stats {
  display: flex;
  gap: 30rpx;
}

.stat-item {
  font-size: 24rpx;
  color: #999;
}

.audio-indicator {
  font-size: 24rpx;
  color: #52c41a;
}

.loading, .no-more {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 28rpx;
}

.search-btn {
  position: fixed;
  right: 30rpx;
  bottom: 100rpx;
  width: 100rpx;
  height: 100rpx;
  background: #1a1a2e;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.2);
}

.search-icon {
  width: 50rpx;
  height: 50rpx;
}
